# =============================================================================
# MUNSHI MICROSERVICES - ENVIRONMENT CONFIGURATION
# =============================================================================
# This file contains ONLY infrastructure settings, secrets, and deployment-specific values
# Application behavior and business logic are configured in service config.json files

# =============================================================================
# DEPLOYMENT ENVIRONMENT
# =============================================================================
ENVIRONMENT=development
DEBUG=false

# =============================================================================
# DATABASE CONFIGURATION (Infrastructure & Secrets)
# =============================================================================

# Authentication Service Database
AUTH_DATABASE_URL=postgresql://auth_user:auth_password@localhost:5433/auth_db

# API Gateway Database  
GATEWAY_DATABASE_URL=postgresql://gateway_user:gateway_password@localhost:5434/gateway_db

# =============================================================================
# REDIS CONFIGURATION (Infrastructure)
# =============================================================================

# Authentication Service Redis (Database 1)
AUTH_REDIS_URL=redis://localhost:6380/1

# API Gateway Redis (Database 0)
GATEWAY_REDIS_URL=redis://localhost:6381/0

# =============================================================================
# SECRETS & SECURITY
# =============================================================================

# JWT Secret (CRITICAL: Change in production!)
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production-minimum-32-characters

# =============================================================================
# SERVICE INFRASTRUCTURE
# =============================================================================

# Service Host/Port Bindings
AUTH_SERVICE_HOST=0.0.0.0
AUTH_SERVICE_PORT=8001
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000

# Service-to-Service Communication URLs
AUTH_SERVICE_URL=http://localhost:8001
API_GATEWAY_URL=http://localhost:8000

# =============================================================================
# DEPLOYMENT-SPECIFIC OVERRIDES (Optional)
# =============================================================================
# These override the JSON config defaults for specific deployments

# CORS Origins (deployment-specific)
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://localhost:8000"]

# Rate Limits (deployment-specific overrides)
# RATE_LIMIT_REQUESTS_PER_MINUTE=1000
# GATEWAY_RATE_LIMIT_REQUESTS_PER_MINUTE=5000

# Security Overrides
# TRUSTED_HOSTS_ENABLED=false
# REQUIRE_HTTPS=false

# Logging Level Override
# LOG_LEVEL=INFO

# =============================================================================
# FEATURE FLAGS (Deployment Overrides)
# =============================================================================
# These can override JSON config for specific deployments

# SERVICE_DISCOVERY_ENABLED=true
# RATE_LIMIT_ENABLED=true
# JWT_VERIFICATION_ENABLED=true
# ENABLE_METRICS=true
# HEALTH_CHECK_ENABLED=true