# Example Terraform variables for GCP deployment with pronunciation profiling
# Copy this file to terraform.tfvars and fill in your values

# GCP Configuration
project_id   = "central-list-469110-f1"
region       = "us-central1"
zone         = "us-central1-a"
cluster_name = "munshi-cluster"

# Environment
environment = "production"  # or "staging", "development"
namespace   = "munshi-prod"

# Secrets (set these via environment variables or GCP Secret Manager)
# jwt_secret                  = "your-very-secure-jwt-secret-256-bits"
# postgres_auth_password      = "your-secure-postgres-auth-password"
# postgres_gateway_password   = "your-secure-postgres-gateway-password"

# MongoDB (use MongoDB Atlas or other cloud provider)
# mongodb_url      = "mongodb+srv://username:password@cluster.mongodb.net/"
# mongodb_database = "munshi"
# mongodb_username = "munshi_user"
# mongodb_password = "your-secure-mongodb-password"

# Google API Key for LLM service (Gemini)
# google_api_key = "your-google-gemini-api-key"

# Replica counts for pronunciation profiling
auth_service_replicas  = 2
ui_service_replicas    = 3
audio_service_replicas = 2

# Resource quotas (increased for pronunciation profiling workloads)
total_cpu_requests    = "8"
total_memory_requests = "16Gi"
total_cpu_limits      = "16"
total_memory_limits   = "32Gi"
max_pods             = 150

# GCP-specific
use_cloud_sql   = false  # Using external MongoDB instead
postgres_tier   = "db-f1-micro"
vpc_network     = "default"

# Storage
storage_class = "standard-rwo"

# GKE cluster (optimized for pronunciation profiling)
node_count                   = 3
machine_type                = "e2-standard-4"
enable_memory_intensive_pool = true  # For LLM and ASR services