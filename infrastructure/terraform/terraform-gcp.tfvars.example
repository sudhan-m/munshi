# Munshi Platform - Configuration Example
# Copy this file to terraform.tfvars and fill in your values

# Required: Your GCP Project ID
project_id = "your-gcp-project-id"

# Required: Secrets (generate random strings)
jwt_secret = "your-jwt-secret-key-here"
google_api_key = "your-google-gemini-api-key"

# Optional: Override defaults if needed
# cluster_name = "munshi-cluster"
# region = "us-central1"
# zone = "us-central1-a"
# namespace = "munshi-prod"
# environment = "production"
# use_spot_instances = true

# Optional components (disabled by default for stability)
# enable_cert_manager = false
# enable_ingress_nginx = false
# deployment_timeout = 300

# Database configuration (optional - uses defaults if not specified)
# enable_database_init = true
# postgres_password = "postgres123"
# munshi_db_password = "munshi_password"