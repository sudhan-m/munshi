# Multi-stage Dockerfile optimized for Google Cloud Run
# Stage 1: Build dependencies and download models
FROM python:3.11-slim as builder

# Install build dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    ffmpeg \
    libsndfile1 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create virtual environment
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Copy requirements and install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# Pre-download base models to reduce cold start time (your original choices)
RUN python -c "
from transformers import WhisperForConditionalGeneration, WhisperProcessor
import torch

# Download base models for Cloud Run/CPU mode
print('Downloading whisper-base...')
WhisperForConditionalGeneration.from_pretrained('openai/whisper-base')
WhisperProcessor.from_pretrained('openai/whisper-base')

print('Models downloaded successfully!')
"

# Stage 2: Runtime image
FROM python:3.11-slim as runtime

# Install only runtime dependencies
RUN apt-get update && apt-get install -y \
    ffmpeg \
    libsndfile1 \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Copy virtual environment from builder
COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Copy model cache from builder
COPY --from=builder /root/.cache /root/.cache

# Set working directory
WORKDIR /app

# Copy application code
COPY . .

# Cloud Run specific environment variables
ENV CLOUD_RUN_MODE=true
ENV FALLBACK_MODE=true
ENV GPU_SUPPORT=cpu
ENV MODEL_CACHE_SIZE=1
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

# Optimize Python startup
ENV PYTHONPATH=/app

# Cloud Run health check
HEALTHCHECK --interval=60s --timeout=10s --start-period=120s --retries=3 \
    CMD curl -f http://localhost:$PORT/health || exit 1

# Expose port (Cloud Run will set PORT env var)
EXPOSE 8080

# Use exec form for better signal handling in Cloud Run
CMD ["python", "main.py"]