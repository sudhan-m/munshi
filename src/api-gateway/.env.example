# API Gateway Configuration
GATEWAY_DATABASE_URL=postgresql://gateway_user:gateway_password@localhost:5432/gateway_db
GATEWAY_REDIS_URL=redis://localhost:6379/0

# Gateway Service Configuration
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
ENVIRONMENT=development
DEBUG=false

# Service Discovery
AUTH_SERVICE_URL=http://localhost:8001
SERVICE_DISCOVERY_ENABLED=true
HEALTH_CHECK_INTERVAL=30

# CORS Configuration
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:3001"]
ALLOWED_METHODS=["GET","POST","PUT","DELETE","PATCH","OPTIONS"]
ALLOWED_HEADERS=["*"]
ALLOW_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_ENABLED=true
DEFAULT_RATE_LIMIT_REQUESTS=1000
DEFAULT_RATE_LIMIT_WINDOW=60
AUTHENTICATED_RATE_LIMIT_REQUESTS=5000
AUTHENTICATED_RATE_LIMIT_WINDOW=60

# Request/Response Settings
MAX_REQUEST_SIZE=10485760
REQUEST_TIMEOUT=30

# Circuit Breaker
CIRCUIT_BREAKER_ENABLED=true
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT=60

# Security
JWT_VERIFICATION_ENABLED=true
REQUIRE_HTTPS=false
TRUSTED_PROXIES=["127.0.0.1","::1"]

# Monitoring
METRICS_ENABLED=true
HEALTH_CHECK_ENABLED=true
ACCESS_LOG_ENABLED=true

# Logging
LOG_LEVEL=INFO